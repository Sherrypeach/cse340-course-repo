<section>
  <h1><%= title %></h1>

  <% if (typeof errors !== 'undefined' && errors) { %>
    <ul class="notice">
      <% errors.array().forEach(error => { %>
        <li><%= error.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <form action="/categories/new-category" method="post" novalidate>
    <label for="category_name">Category Name</label>
    <input
      type="text"
      id="category_name"
      name="category_name"
      value="<%= locals.category_name || '' %>"
      required
      maxlength="100"
    >
    <!--
      Note: minlength is intentionally left off the client side here.
      Server-side validation still enforces a 3-character minimum,
      so this lets that server-side rule be tested directly.
    -->

    <button type="submit">Add Category</button>
  </form>
</section>
