<section>
  <div class="page-header">
    <h1>Service Projects</h1>
    <a class="btn" href="/projects/new-project">+ Add New Project</a>
  </div>

  <% if (projectList && projectList.length > 0) { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Project Name</th>
          <th>Organization</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% projectList.forEach(project => { %>
          <tr>
            <td><a href="/projects/<%= project.project_id %>"><%= project.project_name %></a></td>
            <td><%= project.organization_name %></td>
            <td>
              <a href="/projects/edit-project/<%= project.project_id %>">Edit</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>No projects have been added yet.</p>
  <% } %>
</section>
