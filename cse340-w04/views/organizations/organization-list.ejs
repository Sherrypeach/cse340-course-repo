<section>
  <div class="page-header">
    <h1>Organizations</h1>
    <a class="btn" href="/organizations/new-organization">+ Add New Organization</a>
  </div>

  <% if (organizationList && organizationList.length > 0) { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Organization Name</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% organizationList.forEach(org => { %>
          <tr>
            <td><%= org.organization_name %></td>
            <td>
              <a href="/organizations/edit-organization/<%= org.organization_id %>">Edit</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>No organizations have been added yet.</p>
  <% } %>
</section>
