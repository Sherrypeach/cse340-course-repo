<%- include('partials/header') %>

<h1><%= project.name %></h1>
<p><%= project.description %></p>
<p>
  Date: <%= new Date(project.project_date).toLocaleDateString() %><br />
  Time: <%= project.start_time %> - <%= project.end_time %><br />
  Hosted by: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
</p>

<h2>Categories</h2>
<% if (categories.length === 0) { %>
  <p>No categories assigned to this project.</p>
<% } else { %>
  <div class="tags">
    <% categories.forEach(category => { %>
      <a class="tag" href="/category/<%= category.id %>"><%= category.name %></a>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
