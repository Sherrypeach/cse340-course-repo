<%- include('partials/header', { title: title }) %>

<section class="page-intro">
  <h1><%= title %></h1>
  <p>Upcoming and ongoing projects you can join right now.</p>
</section>

<section class="card-grid">
  <% projects.forEach((project) => { %>
    <div class="card">
      <div class="card-body">
        <h2><%= project.title %></h2>
        <span class="badge"><%= project.category %></span>
        <p class="project-meta"><%= project.organization %> &middot; <%= project.date %></p>
        <p><%= project.description %></p>
      </div>
    </div>
  <% }); %>
</section>

<%- include('partials/footer') %>
