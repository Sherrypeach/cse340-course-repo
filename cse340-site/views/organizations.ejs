<%- include('partials/header', { title: title }) %>

<section class="page-intro">
  <h1><%= title %></h1>
  <p>Meet the organizations making a difference in our community.</p>
</section>

<section class="card-grid">
  <% organizations.forEach((org) => { %>
    <div class="card">
      <img src="<%= org.image %>" alt="<%= org.name %> logo" class="card-image">
      <div class="card-body">
        <h2><%= org.name %></h2>
        <span class="badge"><%= org.category %></span>
        <p><%= org.description %></p>
      </div>
    </div>
  <% }); %>
</section>

<%- include('partials/footer') %>
